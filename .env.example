# ============================================================================
# OmniCommerce AI OS — Global Environment Configuration
# ============================================================================

# Server & Environment
APP_ENV=development
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
FRONTEND_ORIGIN=http://localhost:3000

# PostgreSQL (Transactional Store) & Redis (Low-Latency Cache & Rate Limiter)
DATABASE_URL=postgres://omni_admin:omni_secret_password@localhost:5432/omnicommerce_global
REDIS_URL=redis://localhost:6379

# Zero-Knowledge Fraud Network Security (GDPR & Saudi PDPL Compliance)
# Used for HMAC-SHA256 hashing of E.164 phone numbers and emails across tenants
NETWORK_PII_PEPPER=change_this_to_a_64_byte_cryptographic_secret_in_production
JWT_SECRET=change_this_to_a_secure_jwt_signing_key_in_production

# AI Layer (OpenAI GPT-4o Vision + Whisper Voice + Pinecone Vector Search)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_VISION_MODEL=gpt-4o
OPENAI_WHISPER_MODEL=whisper-1
PINECONE_API_KEY=pcsk-your-pinecone-key
PINECONE_INDEX_HOST=https://omnicommerce-catalog.svc.pinecone.io

# Omnichannel Webhooks (Meta WhatsApp Cloud API, Shopify, Salla, Zid)
META_WHATSAPP_VERIFY_TOKEN=omni_whatsapp_verify_token
META_WHATSAPP_ACCESS_TOKEN=EAAG...
META_APP_SECRET=your_meta_app_secret
SHOPIFY_WEBHOOK_SECRET=shpss_your_shopify_secret
SALLA_WEBHOOK_SECRET=salla_your_webhook_secret
ZID_WEBHOOK_SECRET=zid_your_webhook_secret

# Multi-Carrier Logistics (Aramex GCC, Ninja Van SEA, EasyPost Global)
ARAMEX_ACCOUNT_NUMBER=20016
ARAMEX_USERNAME=testingapi@aramex.com
ARAMEX_PASSWORD=your_aramex_password
ARAMEX_ACCOUNT_ENTITY=DXB
ARAMEX_ACCOUNT_COUNTRY_CODE=AE

NINJAVAN_CLIENT_ID=your_ninjavan_client_id
NINJAVAN_CLIENT_SECRET=your_ninjavan_client_secret
NINJAVAN_COUNTRY_CODE=MY

EASYPOST_API_KEY=EZTK_your_easypost_test_key

# SaaS Billing & Instant Prepayment Links (Stripe)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
